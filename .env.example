# ASP.NET maps __ to nested configuration keys.

# App/base URL
App__PublicBaseUrl=http://localhost:5045

# Local SQLite data
Data__ConnectionString=Data Source=App_Data/generic-inventory-dev.db
Data__SeedZipPath=
Data__SeedEnabled=false

# Cookie auth and access bootstrap
Auth__ApproverEmail=luizds979@gmail.com
Auth__StorePath=App_Data/auth-users-dev.json
Auth__CookieName=generic-inventory.dev.auth
Auth__SessionHours=8
Auth__ApprovalTokenHours=72
Auth__PasswordTokenHours=24
Auth__AllowSelfRegistration=true
Auth__Bootstrap__Enabled=true
Auth__Bootstrap__Name=Administrador
Auth__Bootstrap__Email=luizds979@gmail.com
# Optional hash only, never a plain password.
Auth__Bootstrap__PasswordHash=

# Optional approval webhook for access requests. Leave empty to use SMTP/log fallback.
Approval__PowerAutomateWebhookUrl=

# Stock reminders
Reminders__SchedulerEnabled=true
Reminders__PollSeconds=60

# Optional Power Automate HTTP-trigger flows for stock reminders.
# Treat these webhook URLs as secrets; do not commit real values.
PowerAutomateReminders__DailyWebhookUrl=
PowerAutomateReminders__MovementWebhookUrl=
PowerAutomateReminders__ManualWebhookUrl=
PowerAutomateReminders__SharedSecret=
PowerAutomateReminders__TimeoutSeconds=20

# SMTP fallback. Keep real passwords in environment/secrets only.
Smtp__Host=
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__User=
Smtp__Password=
Smtp__From=no-reply@generic-inventory.local
